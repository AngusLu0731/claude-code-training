---
/**
 * 首頁「完成 x/N」。N 在 build 時由各章與期末作業的 mdx 原文經 checklist-ids parser 算出；
 * 瀏覽器端只計清單內的 id。根元素 data-total 供 e2e 讀。
 */
import { collectChecklistIds } from '../lib/checklist-ids';

const raw = import.meta.glob('/src/content/docs/0[1-6]-*.mdx', { query: '?raw', eager: true, import: 'default' });
const ids = collectChecklistIds(Object.values(raw) as string[]);
const total = ids.length;
---

<div class="progress" id="cc-progress" data-total={total} data-ids={ids.join(' ')}>
	<p class="progress-line">
		<strong>你的進度</strong>：完成 <span data-done>0</span>/<span data-total-count>{total}</span> 項自檢
		<span class="progress-note">（只存在這台電腦的瀏覽器）</span>
	</p>
	<div class="progress-track" role="presentation">
		<div class="progress-fill" data-fill></div>
	</div>
</div>

<script>
	function refresh() {
		const root = document.getElementById('cc-progress');
		if (!root) return;
		const ids = (root.dataset.ids ?? '').split(' ').filter(Boolean);
		let done = 0;
		for (const id of ids) {
			try {
				if (localStorage.getItem('cc-training:' + id) === '1') done += 1;
			} catch {
				/* 讀不到就當 0 */
			}
		}
		const slot = root.querySelector('[data-done]');
		if (slot) slot.textContent = String(done);
		const fill = root.querySelector<HTMLElement>('[data-fill]');
		if (fill) fill.style.width = ids.length ? `${(done / ids.length) * 100}%` : '0%';
	}
	refresh();
	document.addEventListener('cc-training:progress', refresh);
</script>

<style>
	.progress {
		padding: 0.75rem 1rem;
		border-radius: 0.75rem;
		background: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-hairline);
	}
	.progress-line {
		margin: 0;
	}
	.progress-note {
		color: var(--sl-color-gray-3);
		font-size: 0.85em;
	}
	.progress-track {
		margin-top: 0.6rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-hairline);
		overflow: hidden;
	}
	.progress-fill {
		height: 100%;
		width: 0;
		border-radius: 999px;
		background: var(--sl-color-accent);
		transition: width 0.3s ease;
	}
</style>
